# Environment Variables for AssetFlow Backend
# Copy this file to .env and fill in your values

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/assetflow?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# Set to true if your network blocks MongoDB Atlas DNS (SRV) lookups
USE_GOOGLE_DNS=false
